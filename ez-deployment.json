{
  "schemaVersion": 2,
  "services": {
    "library": {
      "buildTarget": "runtime",
      "volumes": {
        "data": "/state"
      },
      "healthcheck": [
        "node",
        "/app/bin/ez-library.mjs",
        "--version"
      ],
      "memoryMiB": 4096,
      "cpus": 2
    }
  },
  "commands": {
    "library": {
      "service": "library",
      "argv": [
        "node",
        "/app/bin/ez-library.mjs"
      ]
    }
  }
}
