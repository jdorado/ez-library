{
  "schemaVersion": 3,
  "services": {
    "library": {
      "buildTarget": "runtime",
      "volumes": {
        "data": "/state"
      },
      "healthcheck": [
        "node",
        "/app/bin/ez-library.mjs",
        "--version"
      ],
      "memoryMiB": 4096,
      "cpus": 2
    }
  },
  "commands": {
    "library": {
      "service": "library",
      "argv": [
        "node",
        "/app/bin/ez-library.mjs"
      ]
    }
  },
  "sharedServices": {
    "embeddings": {
      "identity": "qmd-embeddings-v1",
      "buildTarget": "embeddings",
      "memoryMiB": 2048,
      "healthcheck": [
        "node",
        "/app/src/embedding-worker.mjs",
        "--health"
      ],
      "clients": [
        "library"
      ],
      "clientEnvironment": {
        "EZ_LIBRARY_EMBED_SOCKET": "/inference/worker.sock"
      },
      "files": [
        "Dockerfile",
        "docker/pnpm-lock.yaml",
        "src/embedding-worker.mjs",
        "src/embedding-client.mjs",
        "patches/@tobilu__qmd@2.8.3.patch"
      ],
      "cpus": 0.5
    }
  }
}
