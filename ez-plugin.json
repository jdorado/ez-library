{
  "schemaVersion": 1,
  "id": "library",
  "version": "0.1.0-beta.13",
  "description": "Dockerized agent library files, QMD retrieval and explicit persistence settings",
  "commands": {
    "library": {
      "executable": "bin/ez-library.mjs",
      "args": []
    },
    "library-file": {
      "executable": "bin/ez-library.mjs",
      "args": ["file"],
      "channelFile": true,
      "exposure": {
        "receivesExternalContent": true,
        "sendsExternally": false,
        "changesRecords": false,
        "requiresReview": false
      }
    },
    "library-query": {
      "executable": "bin/ez-library.mjs",
      "args": [],
      "channelQuery": true,
      "exposure": {
        "receivesExternalContent": true,
        "sendsExternally": false,
        "changesRecords": false,
        "requiresReview": false
      }
    }
  },
  "skills": [
    "skills/library/SKILL.md"
  ]
}
